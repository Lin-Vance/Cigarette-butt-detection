# 依赖与构建产物
node_modules/
dist/
# 备用构建输出目录：本机沙箱会在 `vite build` 清空 dist 时触发批量删除保护，
# 故验证构建时改用 `vite build --outDir dist-verify`，这里一并忽略。
dist-verify/

# 本地环境变量（每台机器不同，不要提交）
.env.local
.env.*.local

# Vite 崩溃时残留的临时配置（缺陷 D-16）
vite.config.ts.timestamp-*.mjs

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

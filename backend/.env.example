# 复制为 .env 后按需修改。不配置也能跑（全部走默认值：SQLite + 本地 storage/）。

# 后端监听
HOST=127.0.0.1
PORT=8000

# 数据库：默认 SQLite 零依赖
# DATABASE_URL=sqlite+aiosqlite:///./data/yanzong.db
# 切 PostgreSQL（需先安装 asyncpg 并建库）：
# DATABASE_URL=postgresql+asyncpg://yanzong:yanzong@127.0.0.1:5432/yanzong

# JWT 密钥（演示用；正式部署必须更换）
JWT_SECRET=yanzong-demo-secret-change-me

# 演示数据量级：design（设计稿量级）/ pilot（2-4 路摄像头试点量级）
DEFAULT_SCALE_MODE=pilot

# 启动时灌入演示数据
SEED_ON_STARTUP=true

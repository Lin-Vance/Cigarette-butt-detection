# 复制为 .env 后按需修改。不配置也能跑（全部走默认值：SQLite + 本地 storage/）。

# 后端监听
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# MySQL 8.0（先执行 scripts/mysql-bootstrap.sql 创建数据库与专用账号）
DATABASE_URL=mysql+aiomysql://yanzong:请替换数据库密码@127.0.0.1:3306/yanzong?charset=utf8mb4

# Redis 用于验证码、登录限频与 WebSocket 跨进程广播
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=yanzong

# JWT 密钥（演示用；正式部署必须更换）
JWT_SECRET=replace-with-at-least-32-random-characters-before-production
# 生产部署必须设为 false，并由短信服务发送验证码
EXPOSE_DEMO_CODES=true

# 演示数据量级：design（设计稿量级）/ pilot（2-4 路摄像头试点量级）
DEFAULT_SCALE_MODE=pilot

# 启动时灌入演示数据
SEED_ON_STARTUP=true
